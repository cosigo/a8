<script>
(() => {
  "use strict";

  const PAGE_MODE = "audio";

  const CORE_URL = "/api/state";

  const DAY_STATES = 131072;     // 32 * 64 * 64
  const A8_SECONDS_PER_HOUR = 4096; // 64 * 64

  const Q = 1 / 4;
  const H = 1 / 2;
  const W = 1;
  const D = 2;

  // ----------------------------------------------------------
  // NATIVE A8 PITCHES
  //
  // All values are cycles / A8 second.
  // No Hz exists in the musical definition.
  // ----------------------------------------------------------

  const P = {
    ONE:   256,
    TWO:   288,          // 256 * 9/8
    THREE: 320,          // 256 * 5/4
    FOUR:  256 * 4/3,
    FIVE:  384,          // 256 * 3/2
    SIX:   256 * 5/3,
    SEVEN: 480,          // 256 * 15/8
    EIGHT: 512
  };


  // ----------------------------------------------------------
  // CLOCK CHIME
  // Distinct short descending signature.
  // ----------------------------------------------------------

  const CLOCK_CHIME = [
    [P.EIGHT, Q],
    [P.FIVE,  Q],
    [P.THREE, H],
    [P.ONE,   W]
  ];


  // ----------------------------------------------------------
  // AUDIO PAGE TUNE
  //
  // MICRO climbs.
  // MACRO descends.
  // The final phrase converges.
  // ----------------------------------------------------------

  const THREE_WITNESSES = [

    // MICRO — bottom up
    [P.ONE,   Q],
    [P.TWO,   Q],
    [P.THREE, H],
    [P.FIVE,  W],

    [0, Q],

    // MACRO — top down
    [P.EIGHT, Q],
    [P.SEVEN, Q],
    [P.SIX,   H],
    [P.FIVE,  W],

    [0, Q],

    // WHERE · HOW FAR · WHEN
    [P.ONE,   Q],
    [P.THREE, Q],
    [P.FIVE,  H],

    [P.TWO,   Q],
    [P.FOUR,  Q],
    [P.SIX,   H],

    [P.THREE, Q],
    [P.FIVE,  Q],
    [P.EIGHT, W],

    [0, H],

    // MEET
    [P.EIGHT, Q],
    [P.SIX,   Q],
    [P.FIVE,  H],
    [P.THREE, H],
    [P.TWO,   H],
    [P.ONE,   D]
  ];


  // ----------------------------------------------------------
  // STATE
  // ----------------------------------------------------------

  let audio = null;
  let oscillator = null;
  let gain = null;

  let previous = null;

  let ticksPerA8Second = null;
  let audioSecondsPerTick = null;
  let audioSecondsPerA8Second = null;

  let currentCore = null;

  let player = null;

  let chimeArmed = false;
  let chimeTestPending = false;
  let previousHour = null;
  let previousPhase = null;

  let tuneStartRequested = false;

  let requestBusy = false;
  let frameCounter = 0;


  // ----------------------------------------------------------
  // PAGE ELEMENTS
  // ----------------------------------------------------------

  function el(id) {
    return document.getElementById(id);
  }


  // ----------------------------------------------------------
  // RECURSIVE CORE FIELD LOOKUP
  // ----------------------------------------------------------

  function findExactKey(root, wanted) {

    if (!root || typeof root !== "object") {
      return undefined;
    }

    const target = wanted.toLowerCase();

    const stack = [root];

    while (stack.length) {

      const obj = stack.pop();

      if (!obj || typeof obj !== "object") continue;

      for (const [key, value] of Object.entries(obj)) {

        if (key.toLowerCase() === target) {
          return value;
        }

        if (value && typeof value === "object") {
          stack.push(value);
        }
      }
    }

    return undefined;
  }


  function firstValue(root, names) {

    for (const name of names) {

      const value = findExactKey(root, name);

      if (value !== undefined && value !== null) {
        return value;
      }
    }

    return undefined;
  }


  function asNumber(value) {

    if (
      typeof value === "number" &&
      Number.isFinite(value)
    ) {
      return value;
    }

    if (typeof value === "string") {

      const n = Number(value);

      if (Number.isFinite(n)) {
        return n;
      }
    }

    return null;
  }


  function corePhase(state) {

    return asNumber(
      firstValue(state, [
        "dayPhase17",
        "day_phase17",
        "DAY_PHASE17",
        "clockPhase17",
        "a8DayPhase17",
        "dayPhase"
      ])
    );
  }


  function coreRawTicks(state) {

    return asNumber(
      firstValue(state, [
        "rawTicks",
        "raw_ticks",
        "RAW_TICKS",
        "rawPulseCount",
        "raw_pulse_count",
        "pulseCount",
        "pulse_count",
        "pulseCounter",
        "edgeCount",
        "rawEdges",
        "oscillatorCount",
        "tickCount",
        "plantStep",
        "plantSteps"
      ])
    );
  }


  function coreRunning(state) {

    const stopped = firstValue(state, [
      "stopped",
      "clockStopped",
      "clock_stopped",
      "isStopped"
    ]);

    if (stopped === true) {
      return false;
    }

    const value = firstValue(state, [
      "running",
      "clockRunning",
      "clock_running",
      "isRunning",
      "runState",
      "clockState"
    ]);

    if (typeof value === "boolean") {
      return value;
    }

    if (typeof value === "number") {
      return value !== 0;
    }

    if (typeof value === "string") {

      const x = value.trim().toUpperCase();

      if (
        x.includes("STOP") ||
        x.includes("PAUSE") ||
        x === "OFF"
      ) {
        return false;
      }

      if (
        x.includes("RUN") ||
        x.includes("ACTIVE") ||
        x.includes("HOLDOVER") ||
        x.includes("LOCK") ||
        x.includes("QUALIFIED")
      ) {
        return true;
      }
    }

    // If the endpoint supplied valid native counters but no
    // explicit run flag, treat the core state as observable.
    return true;
  }


  // ----------------------------------------------------------
  // AUDIO DEVICE
  //
  // This is downstream only.
  // It does not establish A8 time.
  // ----------------------------------------------------------

  function ensureAudio() {

    if (!audio) {

      audio = new (
        window.AudioContext ||
        window.webkitAudioContext
      )();
    }

    if (audio.state === "suspended") {
      audio.resume();
    }

    return audio;
  }


  function killTone() {

    if (oscillator) {

      try {
        oscillator.stop();
      } catch {}

      try {
        oscillator.disconnect();
      } catch {}
    }

    if (gain) {

      try {
        gain.disconnect();
      } catch {}
    }

    oscillator = null;
    gain = null;
  }


  // ----------------------------------------------------------
  // TRANSLATE NATIVE PITCH TO PHYSICAL DAC
  //
  // nativeCyclesPerA8Second
  // -----------------------
  // observed audio-device duration of one recovered A8 second
  //
  // No predefined legacy-second conversion is used.
  // ----------------------------------------------------------

  function startTone(nativeCyclesPerA8Second, waveform) {

    killTone();

    if (!nativeCyclesPerA8Second) {
      return;
    }

    if (
      !audioSecondsPerA8Second ||
      !(audioSecondsPerA8Second > 0)
    ) {
      return;
    }

    const ac = ensureAudio();

    const physicalFrequency =
      nativeCyclesPerA8Second /
      audioSecondsPerA8Second;

    oscillator = ac.createOscillator();
    gain = ac.createGain();

    oscillator.type = waveform;

    oscillator.frequency.setValueAtTime(
      physicalFrequency,
      ac.currentTime
    );

    gain.gain.setValueAtTime(
      0.045,
      ac.currentTime
    );

    oscillator.connect(gain);
    gain.connect(ac.destination);

    oscillator.start();
  }


  // ----------------------------------------------------------
  // BEAT DISPLAY
  // ----------------------------------------------------------

  function beatLabel(v) {

    if (v === Q) return "¼ A8 second";
    if (v === H) return "½ A8 second";
    if (v === W) return "1 A8 second";
    if (v === D) return "2 A8 seconds";

    return String(v) + " A8 second";
  }


  function pitchLabel(v) {

    if (!v) return "REST";

    const rounded =
      Math.abs(v - Math.round(v)) < 1e-9
      ? String(Math.round(v))
      : v.toFixed(3);

    return rounded + " cycles / A8 second";
  }


  // ----------------------------------------------------------
  // CORE-DERIVED PLAYER
  //
  // Score position is never advanced by a browser timer.
  //
  // elapsed A8 time =
  //
  //     raw core pulse delta
  //     --------------------
  //     recovered pulses per A8 second
  // ----------------------------------------------------------

  function totalDuration(sequence) {

    return sequence.reduce(
      (sum, item) => sum + item[1],
      0
    );
  }


  function beginSequence(sequence, mode) {

    if (
      !currentCore ||
      !currentCore.running ||
      ticksPerA8Second === null ||
      audioSecondsPerA8Second === null
    ) {
      return false;
    }

    ensureAudio();

    player = {
      sequence,
      mode,
      startTick: currentCore.raw,
      noteIndex: -1,
      duration: totalDuration(sequence)
    };

    updatePlayer();

    return true;
  }


  function stopSequence(reason) {

    killTone();

    player = null;
    tuneStartRequested = false;

    if (PAGE_MODE === "audio") {

      const status = el("a8-tune-status");
      const note = el("a8-tune-note");

      if (status) {
        status.innerHTML =
          "CORE: " + coreStatusText() +
          "<br>MUSIC: " + (reason || "STOPPED");
      }

      if (note) {
        note.innerHTML =
          "PITCH: —<br>BEAT: —";
      }
    }
  }


  function updatePlayer() {

    if (!player || !currentCore) return;

    if (!currentCore.running) {

      stopSequence("STOPPED WITH CORE");
      return;
    }

    if (
      ticksPerA8Second === null ||
      !(ticksPerA8Second > 0)
    ) {
      return;
    }

    const elapsedA8 =
      (currentCore.raw - player.startTick) /
      ticksPerA8Second;

    if (elapsedA8 < 0) {

      stopSequence("CORE RESET");
      return;
    }

    if (elapsedA8 >= player.duration) {

      killTone();

      if (player.mode === "audio") {

        const status = el("a8-tune-status");
        const note = el("a8-tune-note");

        if (status) {
          status.innerHTML =
            "CORE: " + coreStatusText() +
            "<br>MUSIC: COMPLETE";
        }

        if (note) {
          note.innerHTML =
            "PITCH: —<br>BEAT: —";
        }
      }

      player = null;
      return;
    }

    let cursor = 0;
    let index = -1;

    for (let i = 0; i < player.sequence.length; i++) {

      const duration = player.sequence[i][1];

      if (
        elapsedA8 >= cursor &&
        elapsedA8 < cursor + duration
      ) {
        index = i;
        break;
      }

      cursor += duration;
    }

    if (index === -1) return;

    if (index !== player.noteIndex) {

      player.noteIndex = index;

      const [pitch, duration] =
        player.sequence[index];

      startTone(
        pitch,
        player.mode === "clock"
          ? "triangle"
          : "square"
      );

      if (player.mode === "clock") {

        const note = el("a8-chime-note");

        if (note) {
          note.innerHTML =
            "PITCH: " + pitchLabel(pitch) +
            "<br>BEAT: " + beatLabel(duration);
        }

      } else {

        const note = el("a8-tune-note");

        if (note) {
          note.innerHTML =
            "PITCH: " + pitchLabel(pitch) +
            "<br>BEAT: " + beatLabel(duration);
        }
      }
    }
  }


  // ----------------------------------------------------------
  // CALIBRATE NATIVE CORE SCALE
  //
  // rawTicks / DAY_PHASE17
  //
  // establishes pulses per A8 second.
  //
  // AudioContext currentTime is observed simultaneously only
  // to make the downstream DAC reproduce native frequency.
  // ----------------------------------------------------------

  function smooth(oldValue, newValue, weight) {

    if (oldValue === null) {
      return newValue;
    }

    return (
      oldValue * (1 - weight) +
      newValue * weight
    );
  }


  function processCoreState(state) {

    const phase = corePhase(state);
    const raw = coreRawTicks(state);

    if (phase === null || raw === null) {

      coreFailure(
        "NATIVE CORE FIELDS NOT FOUND"
      );

      return;
    }

    const running = coreRunning(state);

    const acNow =
      audio ? audio.currentTime : null;

    if (
      previous &&
      raw > previous.raw
    ) {

      const dRaw = raw - previous.raw;

      // ---------------------------------------------
      // Native scale:
      // core raw pulses per whole A8 second
      // ---------------------------------------------

      let dPhase =
        phase - previous.phase;

      if (dPhase < 0) {
        dPhase += DAY_STATES;
      }

      if (
        dPhase > 0 &&
        dPhase < 64
      ) {

        const sample =
          dRaw / dPhase;

        if (
          Number.isFinite(sample) &&
          sample > 0
        ) {

          ticksPerA8Second =
            smooth(
              ticksPerA8Second,
              sample,
              0.20
            );
        }
      }

      // ---------------------------------------------
      // Downstream audio translation only.
      // ---------------------------------------------

      if (
        acNow !== null &&
        previous.audioNow !== null
      ) {

        const dAudio =
          acNow - previous.audioNow;

        if (dAudio > 0) {

          const sample =
            dAudio / dRaw;

          if (
            Number.isFinite(sample) &&
            sample > 0
          ) {

            audioSecondsPerTick =
              smooth(
                audioSecondsPerTick,
                sample,
                0.08
              );
          }
        }
      }
    }

    if (
      ticksPerA8Second !== null &&
      audioSecondsPerTick !== null
    ) {

      audioSecondsPerA8Second =
        ticksPerA8Second *
        audioSecondsPerTick;
    }

    currentCore = {
      state,
      phase,
      raw,
      running
    };

    // A raw counter moving backwards means the core/replay
    // has restarted. Active music is invalidated.
    if (
      previous &&
      raw < previous.raw
    ) {

      killTone();
      player = null;
      tuneStartRequested = false;
    }

    previous = {
      phase,
      raw,
      audioNow: acNow
    };

    updateUI();
    updateClockTrigger();
    updatePlayer();

    if (
      PAGE_MODE === "audio" &&
      tuneStartRequested &&
      !player &&
      coreReady()
    ) {

      tuneStartRequested = false;

      beginSequence(
        THREE_WITNESSES,
        "audio"
      );
    }
  }


  // ----------------------------------------------------------
  // CORE STATUS
  // ----------------------------------------------------------

  function coreReady() {

    return !!(
      currentCore &&
      currentCore.running &&
      ticksPerA8Second !== null &&
      audioSecondsPerA8Second !== null
    );
  }


  function coreStatusText() {

    if (!currentCore) {
      return "ACQUIRING";
    }

    if (!currentCore.running) {
      return "STOPPED";
    }

    if (
      ticksPerA8Second === null ||
      audioSecondsPerA8Second === null
    ) {
      return "CALIBRATING";
    }

    return "A8 RECOVERY CORE";
  }


  function coreFailure(message) {

    killTone();

    player = null;
    tuneStartRequested = false;

    currentCore = null;

    if (PAGE_MODE === "clock") {

      const status = el("a8-chime-status");
      const note = el("a8-chime-note");

      if (status) {
        status.innerHTML =
          "CORE: LOST<br>" +
          "CHIME: SILENT";
      }

      if (note) {
        note.innerHTML =
          "PITCH: —<br>" +
          "BEAT: —<br>" +
          String(message || "");
      }

    } else {

      const status = el("a8-tune-status");
      const note = el("a8-tune-note");

      if (status) {
        status.innerHTML =
          "CORE: LOST<br>" +
          "MUSIC: STOPPED";
      }

      if (note) {
        note.innerHTML =
          "PITCH: —<br>" +
          "BEAT: —<br>" +
          String(message || "");
      }
    }
  }


  // ----------------------------------------------------------
  // CLOCK TRIGGER
  // ----------------------------------------------------------

  function updateClockTrigger() {

    if (
      PAGE_MODE !== "clock" ||
      !currentCore
    ) {
      return;
    }

    const phase = currentCore.phase;

    const hour =
      Math.floor(
        phase /
        A8_SECONDS_PER_HOUR
      );

    // Test chime begins only when the CORE advances
    // into a new whole A8 second.
    if (
      chimeTestPending &&
      previousPhase !== null &&
      phase !== previousPhase &&
      coreReady()
    ) {

      chimeTestPending = false;

      beginSequence(
        CLOCK_CHIME,
        "clock"
      );
    }

    // Armed hour chime.
    if (
      previousHour !== null &&
      hour !== previousHour &&
      chimeArmed &&
      coreReady()
    ) {

      beginSequence(
        CLOCK_CHIME,
        "clock"
      );
    }

    previousHour = hour;
    previousPhase = phase;
  }


  // ----------------------------------------------------------
  // UI
  // ----------------------------------------------------------

  function updateUI() {

    if (PAGE_MODE === "clock") {

      const status = el("a8-chime-status");

      if (status) {

        status.innerHTML =
          "CORE: " +
          coreStatusText() +
          "<br>CHIME: " +
          (
            chimeArmed
              ? "ARMED"
              : "DISARMED"
          ) +
          (
            chimeTestPending
              ? "<br>TEST: NEXT A8 SECOND"
              : ""
          );
      }

    } else {

      const status = el("a8-tune-status");

      if (status && !player) {

        status.innerHTML =
          "CORE: " +
          coreStatusText() +
          "<br>MUSIC: " +
          (
            tuneStartRequested
              ? "WAITING FOR CORE"
              : "STOPPED"
          );
      }
    }
  }


  // ----------------------------------------------------------
  // CONTROLS
  // ----------------------------------------------------------

  if (PAGE_MODE === "clock") {

    const arm = el("a8-chime-arm");
    const test = el("a8-chime-test");

    if (arm) {

      arm.addEventListener(
        "click",
        () => {

          ensureAudio();

          chimeArmed =
            !chimeArmed;

          arm.textContent =
            chimeArmed
              ? "DISARM A8 HOUR CHIME"
              : "ARM A8 HOUR CHIME";

          updateUI();
        }
      );
    }

    if (test) {

      test.addEventListener(
        "click",
        () => {

          ensureAudio();

          chimeTestPending = true;

          updateUI();
        }
      );
    }

  } else {

    const start = el("a8-tune-start");
    const stop = el("a8-tune-stop");

    if (start) {

      start.addEventListener(
        "click",
        () => {

          ensureAudio();

          stopSequence("STOPPED");

          if (coreReady()) {

            beginSequence(
              THREE_WITNESSES,
              "audio"
            );

          } else {

            tuneStartRequested = true;
            updateUI();
          }
        }
      );
    }

    if (stop) {

      stop.addEventListener(
        "click",
        () => {

          stopSequence("STOPPED");
        }
      );
    }
  }


  // ----------------------------------------------------------
  // CORE OBSERVER
  //
  // requestAnimationFrame controls only how often the browser
  // asks for state.
  //
  // It NEVER advances note phase, beat phase or score position.
  // ----------------------------------------------------------

  async function pollCore() {

    if (requestBusy) return;

    requestBusy = true;

    try {

      const response =
        await fetch(
          CORE_URL,
          { cache: "no-store" }
        );

      if (!response.ok) {
        throw new Error(
          "HTTP " + response.status
        );
      }

      const state =
        await response.json();

      processCoreState(state);

    } catch (err) {

      coreFailure(
        err && err.message
          ? err.message
          : "CORE REQUEST FAILED"
      );

    } finally {

      requestBusy = false;
    }
  }


  function observerLoop() {

    requestAnimationFrame(
      observerLoop
    );

    frameCounter++;

    // Sampling cadence only.
    // Score authority remains native core counters.
    if ((frameCounter & 1) !== 0) {
      return;
    }

    pollCore();
  }


  updateUI();
  observerLoop();

})();
</script>

</body>
</html>
