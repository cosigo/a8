  <section class="panel">
    <h2>Binary A8 frequency ladder</h2>
    <p class="small">
      Every adjacent button is an exact ×2 or ÷2 in <b>cycles per A8 second</b>.
      The small Hz number is deliberately secondary and generally does not look clean.
    </p>
    <div class="grid" id="buttons"></div>
  </section>

  <section class="panel">
    <h2>Direct A8 frequency</h2>
    <div class="controls">
      <label>
        Cycles per A8 second
        <input id="freq" type="number" min="0.125" step="0.125" value="512">
      </label>
      <button id="playDirect">PLAY A8 FREQUENCY</button>
      <button id="half">÷ 2 A8</button>
      <button id="double">× 2 A8</button>
    </div>
    <p class="small">
      Halving and doubling operate on the native A8 frequency value. The physical browser oscillator is translated afterward.
    </p>
  </section>

  <section class="panel reference-read" id="conversionBox">
    <h2>Reference translation — audio-output boundary</h2>
    <p>
      A8 frequency is counted in <b>cycles per A8 SECOND</b>. The A8 timebase is referenced to the
      Jovian 1:2:4 recovery architecture — <b>Io ×4 · Europa ×2 · Ganymede ×1</b>.
      The conventional value below exists only so the browser audio engine can render the selected
      native A8 frequency. It is an implementation reference, not the A8 frequency ruler.
    </p>
    <div class="trainer-note">
      <div>
        <span class="k">Selected A8 frequency</span>
        <div class="big" id="convA8">512</div>
        <div class="small">cycles / A8 second</div>
      </div>
      <div>
        <span class="k">Web Audio output target</span>
        <div class="big" id="convHz">776.722963</div>
        <div class="small">Hz · implementation reference</div>
      </div>
      <div>
        <span class="k">A8 timebase reference</span>
        <div class="big">Jovian 1:2:4 recovery</div>
        <div class="small">Io ×4 · Europa ×2 · Ganymede ×1</div>
      </div>
      <div>
        <span class="k">Output boundary</span>
        <div class="big">A8 defines the frequency</div>
        <div class="small">Web Audio renders it through conventional browser / audio hardware</div>
      </div>
    </div>
  </section>

<script>
let ctx = null;
let osc = null;
let gain = null;
let scopeEnabled = true;
let currentA8 = null;

// Exact development translation from the current A8 clock:
// 1 A8 second = 675 / 1024 conventional seconds.
const A8_TO_LEGACY_HZ = 1024 / 675;
const LEGACY_HZ_TO_A8 = 675 / 1024;

const ladder = [16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768];

const $ = id => document.getElementById(id);

function a8ToLegacyHz(a8Frequency) {
  return a8Frequency * A8_TO_LEGACY_HZ;
}

function legacyHzToA8(hz) {
  return hz * LEGACY_HZ_TO_A8;
}

function formatA8(v) {
  if (Number.isInteger(v)) return String(v);
  return Number(v.toFixed(6)).toString();
}

function formatHz(v) {
  return Number(v).toFixed(6).replace(/0+$/,'').replace(/\.$/,'');
}

function octaveDistanceFromAnchor(a8Frequency) {
  const ratio = a8Frequency / 512;
  if (!(ratio > 0)) return null;
  const oct = Math.log2(ratio);
  const nearest = Math.round(oct);
  return Math.abs(oct - nearest) < 1e-10 ? nearest : oct;
}

function formatOctaveDistance(a8Frequency) {
  const oct = octaveDistanceFromAnchor(a8Frequency);
  if (oct === null) return '—';
  if (Number.isInteger(oct)) {
    if (oct === 0) return 'anchor · 0 octaves';
    return (oct > 0 ? '+' : '−') + Math.abs(oct) + (Math.abs(oct) === 1 ? ' octave' : ' octaves');
  }
  return (oct > 0 ? '+' : '−') + Math.abs(oct).toFixed(3) + ' octaves';
}

function ensureAudio() {
  if (!ctx) {
    ctx = new (window.AudioContext || window.webkitAudioContext)();
    refreshHardwareLimits();
  }

  if (ctx.state === "suspended") ctx.resume();
}

function maxPlayableHz() {
  return ctx ? ctx.sampleRate / 2 : 22050;
}

function nativeWaveSample(type, cyclePosition) {
  const p = cyclePosition - Math.floor(cyclePosition);

  switch (type) {
    case "triangle":
      return 1 - 4 * Math.abs(p - 0.5);

    case "square":
      return p < 0.5 ? 1 : -1;

    case "sawtooth":
      return 2 * p - 1;

    case "sine":
    default:
      return Math.sin(2 * Math.PI * p);
  }
}

function formatA8TimeValue(value) {
  if (!(value > 0)) return "0";

  const inverse = 1 / value;
  const nearest = Math.round(inverse);

  if (
    Math.abs(inverse - nearest) < 1e-10 &&
    nearest >= 1
  ) {
    return "1/" + nearest;
  }

  return formatA8(value);
}

function formatAmplitudeFraction(value) {
  const n = Math.max(0, Math.min(8, Math.round(Number(value) * 8)));

  const labels = [
    "0",
    "1/8",
    "1/4",
    "3/8",
    "1/2",
    "5/8",
    "3/4",
    "7/8",
    "1"
  ];

  return labels[n];
}

function signedAmplitudeLabel(value) {
  if (Math.abs(value) < 1e-12) return "0";

  const sign = value > 0 ? "+" : "−";
  return sign + formatAmplitudeFraction(Math.abs(value));
}

function drawScope() {
  const canvas = $('scope');
  if (!canvas) return;

  const g = canvas.getContext('2d');
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;

  const pixelW = Math.max(1, Math.round(rect.width * dpr));
  const pixelH = Math.max(1, Math.round(rect.height * dpr));

  if (canvas.width !== pixelW || canvas.height !== pixelH) {
    canvas.width = pixelW;
    canvas.height = pixelH;
  }

  g.setTransform(dpr, 0, 0, dpr, 0, 0);

  const w = rect.width;
  const h = rect.height;

  g.clearRect(0, 0, w, h);

  // ----------------------------------------------------------
  // PLOT GEOMETRY
  //
  // Left band: normalized amplitude labels
  // Bottom band: native A8 time labels
  // ----------------------------------------------------------

  const leftBand = 52;
  const rightPad = 5;
  const topPad = 7;
  const bottomBand = 27;

  const plotX = leftBand;
  const plotY = topPad;
  const plotW = Math.max(1, w - leftBand - rightPad);
  const plotH = Math.max(1, h - topPad - bottomBand);

  const centerY = plotY + plotH / 2;

  const scopeTime = $('scopeTime');
  const windowA8 = Number(scopeTime.value);

  const windowLabel =
    scopeTime.options[scopeTime.selectedIndex].text;

  const accent = getComputedStyle(document.documentElement)
    .getPropertyValue('--accent')
    .trim() || '#6d9cff';

  // ----------------------------------------------------------
  // VERTICAL RULER · NORMALIZED AMPLITUDE
  //
  // +1
  // +7/8
  // ...
  //  0
  // ...
  // -7/8
  // -1
  //
  // This is normalized waveform amplitude, NOT yet a physical
  // A8 voltage / pressure / power unit.
  // ----------------------------------------------------------

  g.font =
    '10px ui-monospace,SFMono-Regular,Menlo,monospace';

  g.textBaseline = 'middle';
  g.textAlign = 'right';

  for (let i = 0; i <= 16; i++) {
    const amplitude = 1 - i / 8;

    const y =
      plotY +
      (i / 16) * plotH;

    const major =
      i === 0 ||
      i === 8 ||
      i === 16 ||
      i % 4 === 0;

    g.strokeStyle =
      i === 8
        ? 'rgba(170,170,170,.55)'
        : major
          ? 'rgba(140,140,140,.35)'
          : 'rgba(128,128,128,.20)';

    g.lineWidth =
      i === 8 ? 1.4 : 1;

    g.beginPath();
    g.moveTo(plotX, y);
    g.lineTo(plotX + plotW, y);
    g.stroke();

    g.fillStyle =
      major
        ? 'rgba(205,205,205,.90)'
        : 'rgba(175,175,175,.72)';

    g.fillText(
      signedAmplitudeLabel(amplitude),
      plotX - 7,
      y
    );
  }

  // ----------------------------------------------------------
  // HORIZONTAL RULER · A8 TIME
  //
  // Eight equal divisions of the selected native time window.
  //
  // Example:
  // 1/64 A8s window
  // each major division = 1/512 A8s.
  // ----------------------------------------------------------

  const divisions = 8;

  g.textBaseline = 'top';
  g.textAlign = 'center';

  for (let i = 0; i <= divisions; i++) {
    const fraction = i / divisions;

    const x =
      plotX +
      fraction * plotW;

    const tA8 =
      windowA8 * fraction;

    g.strokeStyle =
      'rgba(128,128,128,.28)';

    g.lineWidth = 1;

    g.beginPath();
    g.moveTo(x, plotY);
    g.lineTo(x, plotY + plotH);
    g.stroke();

    const labelEvery =
      plotW < 600 ? 2 : 1;

    if (i % labelEvery === 0) {
      const text =
        i === 0
          ? "0"
          : formatA8TimeValue(tA8);

      g.fillStyle =
        'rgba(190,190,190,.82)';

      if (i === 0) {
        g.textAlign = 'left';
        g.fillText(text, x + 2, plotY + plotH + 5);
      } else if (i === divisions) {
        g.textAlign = 'right';
        g.fillText(text, x - 2, plotY + plotH + 5);
      } else {
        g.textAlign = 'center';
        g.fillText(text, x, plotY + plotH + 5);
      }
    }
  }

  $('scopeWindow').textContent = windowLabel;

  const normalizedAmplitude =
    Math.max(
      0,
      Math.min(1, Number($('vol').value))
    );

  const amplitudeLabel =
    formatAmplitudeFraction(normalizedAmplitude);

  if ($('ampRead')) {
    $('ampRead').textContent = amplitudeLabel;
  }

  if ($('scopeAmplitude')) {
    $('scopeAmplitude').textContent = amplitudeLabel;
  }

  if (!scopeEnabled) {
    $('scopeWindow').textContent =
      windowLabel + " · visual OFF";

    $('scopePeriod').textContent = "—";
    return;
  }

  if (!currentA8) {
    $('scopePeriod').textContent = "—";
    return;
  }

  // ----------------------------------------------------------
  // NATIVE A8 WAVEFORM
  //
  // t = native A8 time
  // f = cycles / A8 second
  //
  // phase = f × t
  //
  // amplitude is normalized 0 → 1.
  //
  // No browser Hz.
  // No browser sample clock.
  // No DAC sampling.
  // No analyzer.
  // ----------------------------------------------------------

  const a8Frequency = currentA8;
  const expectedCycles =
    a8Frequency * windowA8;

  const periodA8 =
    1 / a8Frequency;

  const waveform =
    $('wave').value;

  // +1 and -1 correspond exactly to the full vertical
  // normalized-amplitude ruler.
  const vertical =
    (plotH / 2) * normalizedAmplitude;

  // Analytic visual density independent of browser audio sampling.
  const pointCount = Math.min(
    50000,
    Math.max(
      Math.ceil(plotW * 4),
      Math.ceil(expectedCycles * 64),
      256
    )
  );

  g.strokeStyle = accent;
  g.lineWidth = 2;
  g.beginPath();

  for (let i = 0; i <= pointCount; i++) {
    const fraction =
      i / pointCount;

    const x =
      plotX +
      fraction * plotW;

    const tA8 =
      fraction * windowA8;

    const cyclePosition =
      a8Frequency * tA8;

    const sample =
      nativeWaveSample(
        waveform,
        cyclePosition
      );

    const y =
      centerY -
      sample * vertical;

    if (i === 0) {
      g.moveTo(x, y);
    } else {
      g.lineTo(x, y);
    }
  }

  g.stroke();

  $('scopeWindow').textContent =
    windowLabel +
    " · " +
    formatA8(expectedCycles) +
    " cycles";

  $('scopePeriod').textContent =
    formatA8TimeValue(periodA8) +
    " A8s / cycle";
}

function startScope() {
  drawScope();
}

function canPlayA8(a8Frequency) {
  return a8ToLegacyHz(a8Frequency) < maxPlayableHz();
}

function updateReference(a8Frequency) {
  const hz = a8ToLegacyHz(a8Frequency);
  $('convA8').textContent = formatA8(a8Frequency);
  $('convHz').textContent = formatHz(hz);
}

// Audible-output boundary only.
// A8 frequency remains authoritative in cycles per A8 SECOND.
// Web Audio is used only to render that native frequency through
// conventional browser/audio hardware.
const AUDIO_ATTACK_SEC = 0.025;
const AUDIO_RELEASE_SEC = 0.035;

// Downstream browser transducer ceiling only.
// Native scope amplitude remains normalized 0 → 1.
const BROWSER_AUDIO_MAX_GAIN = 0.12;

function stopTone(updateReadout = true) {
  const oldOsc = osc;
  const oldGain = gain;

  osc = null;
  gain = null;
  currentA8 = null;

  if ($('scopeFreq')) {
    $('scopeFreq').textContent = "Stopped";
    drawScope();
  }

  if (oldGain && ctx) {
    const now = ctx.currentTime;
    try {
      oldGain.gain.cancelScheduledValues(now);
      oldGain.gain.setValueAtTime(oldGain.gain.value, now);
      oldGain.gain.linearRampToValueAtTime(0, now + AUDIO_RELEASE_SEC);
    } catch(e) {}
  }

  if (oldOsc && ctx) {
    try { oldOsc.stop(ctx.currentTime + AUDIO_RELEASE_SEC + 0.005); } catch(e) {}
    oldOsc.onended = () => {
      try { oldOsc.disconnect(); } catch(e) {}
      try { oldGain && oldGain.disconnect(); } catch(e) {}
    };
  } else {
    try { oldOsc && oldOsc.disconnect(); } catch(e) {}
    try { oldGain && oldGain.disconnect(); } catch(e) {}
  }

  if (updateReadout) {
    $('a8Read').textContent = "Stopped";
    $('legacyRead').textContent = "—";
    $('relationRead').textContent = "Choose an A8 frequency.";
    $('octaveRead').textContent = "—";
  }
}

function playA8(a8Frequency) {
  const a8 = Number(a8Frequency);
  if (!Number.isFinite(a8) || a8 <= 0) return;

  ensureAudio();
  const hz = a8ToLegacyHz(a8);
  updateReference(a8);

  if (hz >= maxPlayableHz()) {
    stopTone();
    $('a8Read').textContent = formatA8(a8) + " cycles / A8s";
    $('legacyRead').textContent = "≈ " + formatHz(hz) + " Hz";
    $('relationRead').textContent =
      "A8 value is valid, but this browser's Nyquist limit is ≈ " +
      formatHz(maxPlayableHz()) + " Hz.";
    $('octaveRead').textContent = formatOctaveDistance(a8);
    return;
  }

  stopTone(false);
  currentA8 = a8;

  osc = ctx.createOscillator();
  gain = ctx.createGain();

  const now = ctx.currentTime;
  const normalizedLevel = Number($('vol').value);
  const level = normalizedLevel * BROWSER_AUDIO_MAX_GAIN;

  // Sine remains the default/reference source.
  // Other waveform shapes are downstream synthesis /
  // visualization experiments only.
  // Frequency authority remains the native A8 value.
  osc.type = $('wave').value;
  osc.frequency.setValueAtTime(hz, now);

  gain.gain.setValueAtTime(0, now);
  gain.gain.linearRampToValueAtTime(level, now + AUDIO_ATTACK_SEC);

  // Downstream audible demonstration only.
  // Native A8 visual generation is completely independent.
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(now);

  $('a8Read').textContent = formatA8(a8) + " cycles / A8s";
  $('legacyRead').textContent = "≈ " + formatHz(hz) + " Hz";
  $('relationRead').textContent =
    a8 === 512
      ? "512 is the native A8 trainer anchor."
      : "Native A8 frequency · browser conversion occurs only at the audio-output boundary.";
  $('octaveRead').textContent = formatOctaveDistance(a8);

  $('scopeFreq').textContent =
    formatA8(a8) + " cycles / A8s";

  $('scopeWave').textContent =
    $('wave').options[$('wave').selectedIndex].text;

  drawScope();
}

function refreshHardwareLimits() {
  document.querySelectorAll(".freq-btn").forEach(btn => {
    const a8 = Number(btn.dataset.a8);
    const limited = !canPlayA8(a8);
    btn.disabled = limited;
    if (limited) {
      btn.title = "Theoretical A8 value; browser/audio hardware limit prevents clean playback.";
      btn.querySelector(".legacy-ref").textContent =
        "≈ " + formatHz(a8ToLegacyHz(a8)) + " Hz · hardware limit";
    }
  });
}

const buttons = $('buttons');
ladder.forEach(a8 => {
  const btn = document.createElement("button");
  btn.className = "freq-btn";
  btn.dataset.a8 = String(a8);
  if (a8 === 512) btn.classList.add("anchor");

  const nativeValue = document.createElement("span");
  nativeValue.className = "native-value";
  nativeValue.textContent = formatA8(a8);

  const nativeUnit = document.createElement("span");
  nativeUnit.className = "native-unit";
  nativeUnit.textContent = "cycles / A8 second";

  const octaveRef = document.createElement("span");
  octaveRef.className = "octave-ref";
  octaveRef.textContent = formatOctaveDistance(a8) + " from 512";

  const legacyRef = document.createElement("span");
  legacyRef.className = "legacy-ref";
  legacyRef.textContent = "≈ " + formatHz(a8ToLegacyHz(a8)) + " Hz ref";

  btn.append(nativeValue, nativeUnit, octaveRef, legacyRef);
  btn.addEventListener("click", () => {
    $('freq').value = a8;
    playA8(a8);
  });
  buttons.appendChild(btn);
});

$('stop').addEventListener("click", stopTone);

$('playDirect').addEventListener("click", () => {
  const a8 = Number($('freq').value);
  if (Number.isFinite(a8) && a8 > 0) playA8(a8);
});

$('half').addEventListener("click", () => {
  let a8 = Number($('freq').value);
  if (!Number.isFinite(a8) || a8 <= 0) a8 = 512;
  a8 = a8 / 2;
  $('freq').value = formatA8(a8);
  playA8(a8);
});

$('double').addEventListener("click", () => {
  let a8 = Number($('freq').value);
  if (!Number.isFinite(a8) || a8 <= 0) a8 = 512;
  a8 = a8 * 2;
  $('freq').value = formatA8(a8);
  playA8(a8);
});

$('freq').addEventListener("input", () => {
  const a8 = Number($('freq').value);
  if (Number.isFinite(a8) && a8 > 0) updateReference(a8);
});

$('freq').addEventListener("keydown", e => {
  if (e.key === "Enter") $('playDirect').click();
});

// Sine remains the default/reference waveform.
// Triangle, square and sawtooth are downstream sound/scope
// experiments; changing waveform never changes native A8 frequency.
$('wave').value = "sine";
$('scopeWave').textContent = "Sine";

$('wave').addEventListener("change", () => {
  const selected = $('wave').value;

  $('scopeWave').textContent =
    $('wave').options[$('wave').selectedIndex].text;

  if (osc) {
    try {
      osc.type = selected;
    } catch(e) {}
  }

  drawScope();
});

$('scopeToggle').addEventListener("click", () => {
  scopeEnabled = !scopeEnabled;

  $('scopeToggle').textContent =
    scopeEnabled
      ? "SCOPE DISPLAY · ON"
      : "SCOPE DISPLAY · OFF";

  drawScope();
});

$('scopeTime').addEventListener("change", () => {
  drawScope();
});

$('vol').addEventListener("input", () => {
  const normalizedLevel = Number($('vol').value);

  if (gain && ctx) {
    gain.gain.setTargetAtTime(
      normalizedLevel * BROWSER_AUDIO_MAX_GAIN,
      ctx.currentTime,
      0.015
    );
  }

  const label = formatAmplitudeFraction(normalizedLevel);
  $('ampRead').textContent = label;
  $('scopeAmplitude').textContent = label;

  drawScope();
});

$('hideLegacy').addEventListener("change", () => {
  document.body.classList.toggle("hidden-ref", $('hideLegacy').checked);
});

updateReference(512);
drawScope();
</script>
