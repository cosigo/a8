<script>
let ctx = null;
let osc = null;
let gain = null;
let analyser = null;
let scopeData = null;
let scopeFrame = null;
let currentA8 = null;

// Exact development translation from the current A8 clock:
// 1 A8 second = 675 / 1024 conventional seconds.
const A8_TO_LEGACY_HZ = 1024 / 675;
const LEGACY_HZ_TO_A8 = 675 / 1024;

const ladder = [16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768];

const $ = id => document.getElementById(id);

function a8ToLegacyHz(a8Frequency) {
  return a8Frequency * A8_TO_LEGACY_HZ;
}

function legacyHzToA8(hz) {
  return hz * LEGACY_HZ_TO_A8;
}

function formatA8(v) {
  if (Number.isInteger(v)) return String(v);
  return Number(v.toFixed(6)).toString();
}

function formatHz(v) {
  return Number(v).toFixed(6).replace(/0+$/,'').replace(/\.$/,'');
}

function octaveDistanceFromAnchor(a8Frequency) {
  const ratio = a8Frequency / 512;
  if (!(ratio > 0)) return null;
  const oct = Math.log2(ratio);
  const nearest = Math.round(oct);
  return Math.abs(oct - nearest) < 1e-10 ? nearest : oct;
}

function formatOctaveDistance(a8Frequency) {
  const oct = octaveDistanceFromAnchor(a8Frequency);
  if (oct === null) return '—';
  if (Number.isInteger(oct)) {
    if (oct === 0) return 'anchor · 0 octaves';
    return (oct > 0 ? '+' : '−') + Math.abs(oct) + (Math.abs(oct) === 1 ? ' octave' : ' octaves');
  }
  return (oct > 0 ? '+' : '−') + Math.abs(oct).toFixed(3) + ' octaves';
}

function ensureAudio() {
  if (!ctx) {
    ctx = new (window.AudioContext || window.webkitAudioContext)();

    // Passive downstream measurement node.
    // It uses the browser sample clock only to visualize the rendered signal;
    // it has no authority over native A8 frequency.
    analyser = ctx.createAnalyser();
    analyser.fftSize = 32768;
    analyser.smoothingTimeConstant = 0;
    scopeData = new Float32Array(analyser.fftSize);
    analyser.connect(ctx.destination);

    refreshHardwareLimits();
    startScope();
  }
  if (ctx.state === "suspended") ctx.resume();
}

function maxPlayableHz() {
  return ctx ? ctx.sampleRate / 2 : 22050;
}

function drawScope() {
  const canvas = $('scope');
  if (!canvas) return;

  const g = canvas.getContext('2d');
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  const pixelW = Math.max(1, Math.round(rect.width * dpr));
  const pixelH = Math.max(1, Math.round(rect.height * dpr));

  if (canvas.width !== pixelW || canvas.height !== pixelH) {
    canvas.width = pixelW;
    canvas.height = pixelH;
  }

  g.setTransform(dpr, 0, 0, dpr, 0, 0);

  const w = rect.width;
  const h = rect.height;

  g.clearRect(0, 0, w, h);

  // Neutral scope guides.
  g.lineWidth = 1;
  g.strokeStyle = 'rgba(128,128,128,.28)';
  g.beginPath();

  g.moveTo(0, h / 2);
  g.lineTo(w, h / 2);

  g.moveTo(w / 4, 0);
  g.lineTo(w / 4, h);

  g.moveTo(w / 2, 0);
  g.lineTo(w / 2, h);

  g.moveTo(3 * w / 4, 0);
  g.lineTo(3 * w / 4, h);

  g.stroke();

  if (!analyser || !scopeData || !ctx || !currentA8) {
    $('scopeWindow').textContent = '—';
    return;
  }

  analyser.getFloatTimeDomainData(scopeData);

  // Horizontal authority is now the investigator-selected A8 time window.
  // Frequency does NOT determine the displayed window length.
  const windowA8 = Number($('scopeTime').value);

  // Browser-only translation needed to determine how many sampled
  // points correspond to the selected native A8 interval.
  const windowLegacySeconds = windowA8 * (675 / 1024);
  const wanted = Math.round(ctx.sampleRate * windowLegacySeconds);

  const visible = Math.max(
    32,
    Math.min(scopeData.length, wanted)
  );

  // Number of cycles that physically belong inside the selected
  // A8 time interval.
  const expectedCycles = currentA8 * windowA8;

  // Sub-sample rising-edge trigger.
  //
  // A whole-sample trigger produces increasing visible phase jitter
  // as frequency rises. Interpolate between the two samples around
  // the zero crossing so the display trigger is fractional rather
  // than quantized to the browser sample interval.
  let triggerPos = 0;
  const latestTrigger = scopeData.length - visible - 2;

  if (latestTrigger > 1) {
    for (let i = 1; i <= latestTrigger; i++) {
      const y0 = scopeData[i - 1];
      const y1 = scopeData[i];

      if (y0 <= 0 && y1 > 0) {
        const dy = y1 - y0;
        const fraction = dy !== 0 ? (-y0 / dy) : 0;

        triggerPos = (i - 1) + fraction;
        break;
      }
    }
  }

  function scopeSampleAt(position) {
    const i0 = Math.floor(position);
    const f = position - i0;

    const a = scopeData[i0] ?? 0;
    const b =
      scopeData[Math.min(i0 + 1, scopeData.length - 1)] ?? a;

    return a + (b - a) * f;
  }

  let peak = 0;

  for (let i = 0; i < visible; i++) {
    const a = Math.abs(scopeSampleAt(triggerPos + i));
    if (a > peak) peak = a;
  }

  if (peak < 1e-7) {
    $('scopeWindow').textContent = 'signal at zero';
    return;
  }

  // Auto-scale vertically so waveform SHAPE remains visible
  // independently of listening volume.
  const vertical = (h * 0.40) / peak;

  const accent = getComputedStyle(document.documentElement)
    .getPropertyValue('--accent').trim() || '#6d9cff';

  g.lineWidth = 2;
  g.strokeStyle = accent;
  g.beginPath();

  for (let i = 0; i < visible; i++) {
    const x =
      visible <= 1
        ? 0
        : (i / (visible - 1)) * w;

    const y =
      h / 2 -
      scopeSampleAt(triggerPos + i) * vertical;

    if (i === 0) g.moveTo(x, y);
    else g.lineTo(x, y);
  }

  g.stroke();

  const windowLabel =
    $('scopeTime').options[$('scopeTime').selectedIndex].text;

  $('scopeWindow').textContent =
    wanted <= scopeData.length
      ? windowLabel + ' · ' + formatA8(expectedCycles) + ' cycles'
      : windowLabel + ' · analyzer buffer limit';
}

function startScope() {
  if (scopeFrame !== null) return;

  const tick = () => {
    drawScope();
    scopeFrame = requestAnimationFrame(tick);
  };

  tick();
}

function canPlayA8(a8Frequency) {
  return a8ToLegacyHz(a8Frequency) < maxPlayableHz();
}

function updateReference(a8Frequency) {
  const hz = a8ToLegacyHz(a8Frequency);
  $('convA8').textContent = formatA8(a8Frequency);
  $('convHz').textContent = formatHz(hz);
}

// Audible-output boundary only.
// A8 frequency remains authoritative in cycles per A8 SECOND.
// Web Audio is used only to render that native frequency through
// conventional browser/audio hardware.
const AUDIO_ATTACK_SEC = 0.025;
const AUDIO_RELEASE_SEC = 0.035;

function stopTone(updateReadout = true) {
  const oldOsc = osc;
  const oldGain = gain;

  osc = null;
  gain = null;
  currentA8 = null;

  if ($('scopeFreq')) {
    $('scopeFreq').textContent = "Stopped";
  }

  if (oldGain && ctx) {
    const now = ctx.currentTime;
    try {
      oldGain.gain.cancelScheduledValues(now);
      oldGain.gain.setValueAtTime(oldGain.gain.value, now);
      oldGain.gain.linearRampToValueAtTime(0, now + AUDIO_RELEASE_SEC);
    } catch(e) {}
  }

  if (oldOsc && ctx) {
    try { oldOsc.stop(ctx.currentTime + AUDIO_RELEASE_SEC + 0.005); } catch(e) {}
    oldOsc.onended = () => {
      try { oldOsc.disconnect(); } catch(e) {}
      try { oldGain && oldGain.disconnect(); } catch(e) {}
    };
  } else {
    try { oldOsc && oldOsc.disconnect(); } catch(e) {}
    try { oldGain && oldGain.disconnect(); } catch(e) {}
  }

  if (updateReadout) {
    $('a8Read').textContent = "Stopped";
    $('legacyRead').textContent = "—";
    $('relationRead').textContent = "Choose an A8 frequency.";
    $('octaveRead').textContent = "—";
  }
}

function playA8(a8Frequency) {
  const a8 = Number(a8Frequency);
  if (!Number.isFinite(a8) || a8 <= 0) return;

  ensureAudio();
  const hz = a8ToLegacyHz(a8);
  updateReference(a8);

  if (hz >= maxPlayableHz()) {
    stopTone();
    $('a8Read').textContent = formatA8(a8) + " cycles / A8s";
    $('legacyRead').textContent = "≈ " + formatHz(hz) + " Hz";
    $('relationRead').textContent =
      "A8 value is valid, but this browser's Nyquist limit is ≈ " +
      formatHz(maxPlayableHz()) + " Hz.";
    $('octaveRead').textContent = formatOctaveDistance(a8);
    return;
  }

  stopTone(false);
  currentA8 = a8;

  osc = ctx.createOscillator();
  gain = ctx.createGain();

  const now = ctx.currentTime;
  const level = Number($('vol').value);

  // Sine remains the default/reference source.
  // Other waveform shapes are downstream synthesis /
  // visualization experiments only.
  // Frequency authority remains the native A8 value.
  osc.type = $('wave').value;
  osc.frequency.setValueAtTime(hz, now);

  gain.gain.setValueAtTime(0, now);
  gain.gain.linearRampToValueAtTime(level, now + AUDIO_ATTACK_SEC);

  osc.connect(gain);
  gain.connect(analyser);
  osc.start(now);

  $('a8Read').textContent = formatA8(a8) + " cycles / A8s";
  $('legacyRead').textContent = "≈ " + formatHz(hz) + " Hz";
  $('relationRead').textContent =
    a8 === 512
      ? "512 is the native A8 trainer anchor."
      : "Native A8 frequency · browser conversion occurs only at the audio-output boundary.";
  $('octaveRead').textContent = formatOctaveDistance(a8);

  $('scopeFreq').textContent =
    formatA8(a8) + " cycles / A8s";

  $('scopeWave').textContent =
    $('wave').options[$('wave').selectedIndex].text;
}

function refreshHardwareLimits() {
  document.querySelectorAll(".freq-btn").forEach(btn => {
    const a8 = Number(btn.dataset.a8);
    const limited = !canPlayA8(a8);
    btn.disabled = limited;
    if (limited) {
      btn.title = "Theoretical A8 value; browser/audio hardware limit prevents clean playback.";
      btn.querySelector(".legacy-ref").textContent =
        "≈ " + formatHz(a8ToLegacyHz(a8)) + " Hz · hardware limit";
    }
  });
}

const buttons = $('buttons');
ladder.forEach(a8 => {
  const btn = document.createElement("button");
  btn.className = "freq-btn";
  btn.dataset.a8 = String(a8);
  if (a8 === 512) btn.classList.add("anchor");

  const nativeValue = document.createElement("span");
  nativeValue.className = "native-value";
  nativeValue.textContent = formatA8(a8);

  const nativeUnit = document.createElement("span");
  nativeUnit.className = "native-unit";
  nativeUnit.textContent = "cycles / A8 second";

  const octaveRef = document.createElement("span");
  octaveRef.className = "octave-ref";
  octaveRef.textContent = formatOctaveDistance(a8) + " from 512";

  const legacyRef = document.createElement("span");
  legacyRef.className = "legacy-ref";
  legacyRef.textContent = "≈ " + formatHz(a8ToLegacyHz(a8)) + " Hz ref";

  btn.append(nativeValue, nativeUnit, octaveRef, legacyRef);
  btn.addEventListener("click", () => {
    $('freq').value = a8;
    playA8(a8);
  });
  buttons.appendChild(btn);
});

$('stop').addEventListener("click", stopTone);

$('playDirect').addEventListener("click", () => {
  const a8 = Number($('freq').value);
  if (Number.isFinite(a8) && a8 > 0) playA8(a8);
});

$('half').addEventListener("click", () => {
  let a8 = Number($('freq').value);
  if (!Number.isFinite(a8) || a8 <= 0) a8 = 512;
  a8 = a8 / 2;
  $('freq').value = formatA8(a8);
  playA8(a8);
});

$('double').addEventListener("click", () => {
  let a8 = Number($('freq').value);
  if (!Number.isFinite(a8) || a8 <= 0) a8 = 512;
  a8 = a8 * 2;
  $('freq').value = formatA8(a8);
  playA8(a8);
});

$('freq').addEventListener("input", () => {
  const a8 = Number($('freq').value);
  if (Number.isFinite(a8) && a8 > 0) updateReference(a8);
});

$('freq').addEventListener("keydown", e => {
  if (e.key === "Enter") $('playDirect').click();
});

// Sine remains the default/reference waveform.
// Triangle, square and sawtooth are downstream sound/scope
// experiments; changing waveform never changes native A8 frequency.
$('wave').value = "sine";
$('scopeWave').textContent = "Sine";

$('wave').addEventListener("change", () => {
  const selected = $('wave').value;

  $('scopeWave').textContent =
    $('wave').options[$('wave').selectedIndex].text;

  if (osc) {
    try {
      osc.type = selected;
    } catch(e) {}
  }
});

$('vol').addEventListener("input", () => {
  if (gain && ctx) {
    gain.gain.setTargetAtTime(
      Number($('vol').value),
      ctx.currentTime,
      0.015
    );
  }
});

$('hideLegacy').addEventListener("change", () => {
  document.body.classList.toggle("hidden-ref", $('hideLegacy').checked);
});

updateReference(512);
drawScope();
</script>
