#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BASE=http://127.0.0.1:18020
TAG='A8-AUTORECOVER'

log() {
  echo "$TAG · $*"
}

get() {
  local path="$1"
  local out="$2"

  curl \
    --fail \
    --silent \
    --show-error \
    --max-time 10 \
    "$BASE$path" \
    >"$out"
}

post_empty() {
  local path="$1"
  local out="$2"

  curl \
    --fail \
    --silent \
    --show-error \
    --max-time 60 \
    -X POST \
    -H 'Content-Type: application/json' \
    --data '{}' \
    "$BASE$path" \
    >"$out"
}


log 'START'


# ------------------------------------------------------------
# 1. WAIT FOR RECOVERED CORE20 RUNTIME
# ------------------------------------------------------------

READY=0

for attempt in $(seq 1 120); do
  if get \
    /api/core20/clock \
    /tmp/a8-autorecover-clock.json \
    2>/dev/null
  then
    STATUS=$(
      python3 - <<'PY'
import json
import os

with open('/tmp/a8-autorecover-clock.json') as f:
    x = json.load(f)

runtime = (
    x.get('runtime') or
    (x.get('clock') or {}).get('runtime') or
    {}
)

print(runtime.get('status', ''))
PY
    )

    if [ "$STATUS" = RUNNING ]; then
      READY=1
      break
    fi
  fi

  sleep 0.25
done

if [ "$READY" != 1 ]; then
  log 'FAIL · CORE20 RUNTIME DID NOT REACH RUNNING'
  exit 1
fi

log 'PASS · CORE20 RUNTIME RUNNING'


# ------------------------------------------------------------
# QUALIFIED EXTERNAL PHYSICAL PRIMARY BOOTSTRAP
#
# Physical raw count only.
# No timestamp / seconds / Hz / UTC / host elapsed time.
# ------------------------------------------------------------

if [ -f /etc/a8-core20/external-physical-enabled ]; then
  set -a
  . /etc/a8-core20/external-physical.env
  set +a

  log "EXTERNAL PHYSICAL · REQUESTING SOURCE_EPOCH ${A8_CORE20_EXTERNAL_PHYSICAL_EPOCH:-UNKNOWN} PHYSICAL SAMPLE"

  curl     --fail     --silent     --show-error     --max-time 10     http://127.0.0.1:28788/snapshot     >/tmp/a8-autorecover-external-physical-source.json

  python3 - <<'PYPHYSA'
import json
import os

with open(
    '/tmp/a8-autorecover-external-physical-source.json'
) as f:
    x=json.load(f)

assert str(x.get('SOURCE_EPOCH')) == \
    os.environ['A8_CORE20_EXTERNAL_PHYSICAL_EPOCH']
assert x.get('STATUS') == 'ACTIVE'
assert int(x.get('RAW_COUNT')) >= \
    int(os.environ['A8_CORE20_EXTERNAL_PHYSICAL_ANCHOR'])
PYPHYSA

  curl     --fail     --silent     --show-error     --max-time 30     -X POST     -H 'Content-Type: application/json'     -H 'X-A8-External-Physical: 1'     --data-binary       @/tmp/a8-autorecover-external-physical-source.json     "$BASE/api/core20/external-physical/sample"     >/tmp/a8-autorecover-external-physical-core.json

  python3 - <<'YPHYSB'
import json
import os

with open(
    '/tmp/a8-autorecover-external-physical-core.json'
) as f:
    x=json.load(f)

qualified = (
    os.environ.get(
        'A8_CORE20_EXTERNAL_JOVIAN_QUALIFIED'
    ) == '1'
)

expected_role = (
    'QUALIFIED_EXTERNAL_PHYSICAL_PRIMARY'
    if qualified
    else
    'TEMPORARY_EXTERNAL_PHYSICAL_HOLDOVER'
)

assert x.get('ok') is True
assert x.get('mode') == expected_role

c=x.get('clock') or {}
a=c.get('alignment') or {}

assert c.get('status') ==     'CORE20_CLOCK_RUNNING'

assert a.get('role') == expected_role

assert a.get(
    'externalPhysicalSourceEpoch'
) == os.environ['A8_CORE20_EXTERNAL_PHYSICAL_EPOCH']

assert a.get('usesUTC') is False
assert a.get('usesHostTime') is False
assert a.get('nativeAuthority') is False

assert a.get('jovianQualified') is qualified
assert a.get('temporaryEmergency') is (not qualified)

if qualified:
    assert a.get(
        'rateBootstrapProvenance'
    ) == os.environ.get(
        'A8_CORE20_EXTERNAL_RATE_PROVENANCE'
    )

print(
    'A8-AUTORECOVER · EXTERNAL PHYSICAL · CLOCK',
    (c.get('clock') or {}).get('octal')
)

print(
    'A8-AUTORECOVER · EXTERNAL PHYSICAL · PHASE17',
    c.get('dayPhase17')
)
YPHYSB

  log 'PASS · EXTERNAL PHYSICAL PATH APPLIED'
fi


# ------------------------------------------------------------
# 2. NATIVE CIVIL PHASE RECOVERY
#
# NORMAL CE START MAY NOT USE UTC / HOST / BROWSER TIME.
#
# If Core20 has no already-qualified native phase, fail closed.
# Physical outage elapsed time is never invented.
# ------------------------------------------------------------

get \
  /api/core20/clock \
  /tmp/a8-autorecover-clock.json

CLOCK_STATUS=$(
  python3 - <<'PY2'
import json
import os
with open('/tmp/a8-autorecover-clock.json') as f:
    x=json.load(f)
print((x.get('clock') or {}).get('status',''))
PY2
)

case "$CLOCK_STATUS" in
  CORE20_CLOCK_RUNNING)
    if [ -f /etc/a8-core20/external-physical-enabled ]; then
      log "PHASE · ESTABLISHED · ${A8_CORE20_EXTERNAL_PHASE_PROVENANCE:-UNKNOWN_EXTERNAL_BOOTSTRAP} · EXTERNAL PHYSICAL · NO ACTION"
    else
      log 'NATIVE PHASE · ALREADY QUALIFIED · NO ACTION'
    fi
    ;;

  AWAITING_MOMENTARY_CONNECT_ALIGNMENT)
    log 'FAIL · WAITING FOR NATIVE ABSOLUTE DAY_PHASE17'
    log 'FAIL · UTC CONNECT FORBIDDEN'
    log 'FAIL · OUTAGE ELAPSED TIME NOT INFERRED'
    exit 42
    ;;

  *)
    log "FAIL · UNEXPECTED CLOCK STATUS · $CLOCK_STATUS"
    exit 1
    ;;
esac


# Wait for running clock.
CLOCK_READY=0

for attempt in $(seq 1 80); do
  get \
    /api/core20/clock \
    /tmp/a8-autorecover-clock.json

  CLOCK_STATUS=$(
    python3 - <<'PY'
import json
import os

with open('/tmp/a8-autorecover-clock.json') as f:
    x = json.load(f)

print(
    (x.get('clock') or {}).get('status', '')
)
PY
  )

  if [ "$CLOCK_STATUS" = CORE20_CLOCK_RUNNING ]; then
    CLOCK_READY=1
    break
  fi

  sleep 0.25
done

if [ "$CLOCK_READY" != 1 ]; then
  log 'FAIL · CLOCK DID NOT REACH CORE20_CLOCK_RUNNING'
  exit 1
fi

log 'PASS · CORE20 CLOCK RUNNING'


# ------------------------------------------------------------
# 3. NATIVE CALENDAR MUST RESTORE ITSELF
#
# NEVER invent or POST a YEAR DAY here.
# ------------------------------------------------------------

CAL_READY=0

for attempt in $(seq 1 80); do
  if get \
    /api/core20/calendar \
    /tmp/a8-autorecover-calendar.json \
    2>/dev/null
  then
    if python3 - <<'PY'
import json
import os
import sys

with open('/tmp/a8-autorecover-calendar.json') as f:
    x = json.load(f)

c = x.get('calendar') or {}

ok = (
    c.get('status') ==
        'CALENDAR_RUNNING_FROM_CORE20_COUNT'
    and
    c.get('anchored') is True
    and
    c.get('yearDay') is not None
)

sys.exit(0 if ok else 1)
PY
    then
      CAL_READY=1
      break
    fi
  fi

  sleep 0.25
done

if [ "$CAL_READY" != 1 ]; then
  log 'FAIL · NATIVE CALENDAR CHECKPOINT DID NOT RESTORE'
  log 'FAIL · REFUSING TO INVENT OR AUTO-ANCHOR YEAR DAY'
  exit 1
fi

python3 - <<'PY'
import json
import os

with open('/tmp/a8-autorecover-calendar.json') as f:
    x = json.load(f)

c = x['calendar']
p = c.get('persistence') or {}

print(
    'A8-AUTORECOVER · CALENDAR · YEAR DAY',
    c.get('yearDay')
)

print(
    'A8-AUTORECOVER · CALENDAR · AUTHORITY',
    c.get('authority')
)

print(
    'A8-AUTORECOVER · CALENDAR · RESTORE',
    p.get('restorationStatus')
)
PY

log 'PASS · NATIVE CALENDAR RUNNING'


# ------------------------------------------------------------
# 4. YEAR ORIENTATION · RECOVERY ONLY
#
# NORMAL:
#   Existing qualified recovered Year state is required.
#
# EXTERNAL PHYSICAL:
#   Civil clock + native calendar may run while Year Angle
#   remains explicitly UNALIGNED.
#
# NO JPL / NASA / UTC / NETWORK ASTRONOMY IS CALLED HERE.
# ------------------------------------------------------------

get \
  /api/core20/year-angle \
  /tmp/a8-autorecover-year.json

if [ -f /etc/a8-core20/external-physical-enabled ]; then

  python3 - <<'PY2'
import json
import os

with open(
    '/tmp/a8-autorecover-year.json'
) as f:
    x = json.load(f)

y = x.get('yearAngle') or {}

assert y.get('status') == \
    'YEAR_ANGLE_AWAITING_ONE_SHOT_JPL_ALIGN'

assert y.get('aligned') is False

assert y.get('ongoingAuthority') == \
    'RECOVERED_SOL_ORBITAL_ADVANCE_ONLY'

assert y.get('usesJplAfterAlignment') is False
assert y.get('usesUtcAfterAlignment') is False
assert y.get('usesNetworkCadence') is False

print(
    'A8-AUTORECOVER · YEAR ANGLE · '
    'HOLD · UNALIGNED'
)
PY2

  log 'HOLD · YEAR ORIENTATION UNALIGNED BY DESIGN'
  log 'PASS · NO EXTERNAL YEAR BRIDGE REQUESTED'

else

  python3 - <<'PY2'
import json
import os
import sys

with open(
    '/tmp/a8-autorecover-year.json'
) as f:
    x = json.load(f)

y = x.get('yearAngle') or {}

ok = (
    y.get('status') ==
        'YEAR_ANGLE_RUNNING_FROM_RECOVERED_SOL'
    and
    y.get('aligned') is True
    and
    y.get('ongoingAuthority') ==
        'SELECTED_RAW_PLUS_RECOVERED_SOL_ANGLE_PER_RAW'
    and
    y.get('usesJplAfterAlignment') is False
    and
    y.get('usesUtcAfterAlignment') is False
)

if not ok:
    print(
        'FAIL · YEAR ORIENTATION NOT RECOVERABLE '
        'WITHOUT EXTERNAL BRIDGE'
    )
    sys.exit(43)

print(
    'A8-AUTORECOVER · YEAR PHASE ·',
    y.get('phase27Octal')
)
PY2

  log 'PASS · YEAR ANGLE RECOVERED · NO EXTERNAL REQUEST'

fi


# ------------------------------------------------------------
# 5. CROSS-CHECK FINAL OPERATING STATE
# ------------------------------------------------------------

get \
  /api/core20/clock \
  /tmp/a8-autorecover-clock.json

get \
  /api/core20/calendar \
  /tmp/a8-autorecover-calendar.json

get \
  /api/core20/year-angle \
  /tmp/a8-autorecover-year.json

python3 - <<'PY'
import json
import os
from pathlib import Path

def load(path):
    with open(path) as f:
        return json.load(f)

external_physical = Path(
    '/etc/a8-core20/external-physical-enabled'
).exists()

clock = load(
    '/tmp/a8-autorecover-clock.json'
)['clock']

cal = load(
    '/tmp/a8-autorecover-calendar.json'
)['calendar']

year = load(
    '/tmp/a8-autorecover-year.json'
)['yearAngle']

assert clock['status'] ==     'CORE20_CLOCK_RUNNING'

assert cal['status'] ==     'CALENDAR_RUNNING_FROM_CORE20_COUNT'

assert cal['anchored'] is True

assert (
    str(clock['sourceEpoch']) ==
    str(cal['sourceEpoch']) ==
    str(year['sourceEpoch'])
)

ongoing = clock['ongoingReference']

assert ongoing['usesUTC'] is False
assert ongoing['usesBrowserTime'] is False
assert ongoing['usesNTP'] is False
assert ongoing['usesGPS'] is False
assert ongoing['usesLegacySeconds'] is False

assert cal['utcMayAdvanceCalendarDay'] is False
assert cal['jplMayAdvanceCalendarDay'] is False
assert cal['browserMayAdvanceCalendarDay'] is False

if external_physical:
    a = clock.get('alignment') or {}
    runtime = clock.get('runtime') or {}
    paths = runtime.get('pathStatus') or {}

    qualified = (
        os.environ.get(
            'A8_CORE20_EXTERNAL_JOVIAN_QUALIFIED'
        ) == '1'
    )

    expected_role = (
        'QUALIFIED_EXTERNAL_PHYSICAL_PRIMARY'
        if qualified
        else
        'TEMPORARY_EXTERNAL_PHYSICAL_HOLDOVER'
    )

    assert a.get('role') == expected_role

    assert a.get(
        'externalPhysicalSourceEpoch'
    ) == os.environ[
        'A8_CORE20_EXTERNAL_PHYSICAL_EPOCH'
    ]

    assert a.get('nativeAuthority') is False
    assert a.get('usesUTC') is False
    assert a.get('usesHostTime') is False
    assert a.get('jovianQualified') is qualified
    assert a.get('temporaryEmergency') is (not qualified)

    assert runtime.get(
        'monotonicExecutionPace'
    ) == 'EXTERNAL_PHYSICAL_RAW_DELTA_ONLY'

    assert runtime.get(
        'externalPhysicalPrimary'
    ) is True

    assert runtime.get(
        'legacyEmergencyEnabled'
    ) is False

    assert paths.get('primary') == 'ACTIVE'

    assert paths.get(
        'legacyEmergency'
    ) == 'STANDBY_DISCONNECTED'

    assert year['status'] ==         'YEAR_ANGLE_AWAITING_ONE_SHOT_JPL_ALIGN'

    assert year['aligned'] is False

    if qualified:
        assert clock['clockAuthority'] ==             'RECOVERED_JOVIAN_MINTAKA_SOL_SUN_RETURN'

        assert a.get(
            'rateBootstrapProvenance'
        ) == os.environ.get(
            'A8_CORE20_EXTERNAL_RATE_PROVENANCE'
        )

        print(
            'A8-AUTORECOVER · FINAL PASS · '
            'QUALIFIED EXTERNAL PHYSICAL PRIMARY'
        )

    else:
        print(
            'A8-AUTORECOVER · FINAL PASS · '
            'TEMPORARY EXTERNAL PHYSICAL HOLDOVER'
        )

else:
    assert clock['clockAuthority'] ==         'RECOVERED_JOVIAN_MINTAKA_SOL_SUN_RETURN'

    assert year['status'] ==         'YEAR_ANGLE_RUNNING_FROM_RECOVERED_SOL'

    assert year['aligned'] is True

    print(
        'A8-AUTORECOVER · FINAL PASS · NORMAL'
    )

print(
    'SOURCE EPOCH ·',
    clock['sourceEpoch']
)

print(
    'CLOCK        ·',
    clock['clock']['octal']
)

print(
    'YEAR DAY     ·',
    cal['yearDay']
)

if external_physical:
    print(
        'YEAR PHASE27 · HOLD · UNALIGNED'
    )
else:
    print(
        'YEAR PHASE27 ·',
        year['phase27Octal']
    )
PY

log 'COMPLETE'
