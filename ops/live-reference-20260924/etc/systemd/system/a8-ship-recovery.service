[Unit]
Description=A8 Ship Presentation One-Shot Recovery Service
After=network.target
Wants=network.target

[Service]
Type=simple

User=greg
Group=greg

ExecStart=/usr/bin/node /opt/a8-ship-recovery/server.js

Environment=PORT=18022
Environment=TARGET_FILE=/srv/sites/ship.cosigo.io/public/index.html
Environment=RECOVERY_FILE=/opt/a8-ship-recovery/recovery/index.html
Environment=DATA_DIR=/var/lib/a8-ship-recovery
Environment=EXPECTED_SHA=dbd8799b148000fb9cac3f970dbe479eb66c1bcb4d769c2092fb388ae2094a08
Environment=PINNED_TAG=ship-physical-presentation-2026-09-14
Environment=PINNED_COMMIT=LIVE-QUALIFIED-NOT-YET-GIT-PINNED

StateDirectory=a8-ship-recovery
StateDirectoryMode=0750

Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX

ReadWritePaths=/srv/sites/ship.cosigo.io/public
ReadWritePaths=/var/lib/a8-ship-recovery

[Install]
WantedBy=multi-user.target
