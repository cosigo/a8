# ============================================================
# A8 CHIEF ENGINEER · DEDICATED HELM
# Parallel qualification host · lab.cosigo.io remains intact
# ============================================================
ce.cosigo.io {
    encode zstd gzip

    route {
        # Entire CE surface is private.
        basic_auth {
            greg <REDACTED_BCRYPT_HASH>
        }

        # Presentation destinations already migrated.
        @ce_calendar path /calendar.html
        redir @ce_calendar https://calendar.cosigo.io/ 308

        @ce_stars path /celestial.html
        redir @ce_stars https://stars.cosigo.io/ 308

        @ce_map path /map-clock-compass.html
        redir @ce_map https://map.cosigo.io/ 308

        @ce_mintaka path /mintaka.html
        redir @ce_mintaka https://mintaka.cosigo.io/ 308

        @ce_moons path /moons.html
        redir @ce_moons https://moons.cosigo.io/ 308

        @ce_sea path /navigation.html
        redir @ce_sea https://sea.cosigo.io/ 308

        @ce_ship path /relationship.html
        redir @ce_ship https://ship.cosigo.io/ 308

        @ce_sol path /sol.html
        redir @ce_sol https://sol.cosigo.io/ 308

        @ce_index path /index.html
        redir @ce_index / 308

        # Music Review · only routes actually used by CE source.
        @ce_music_review path /api/music-review/current /api/music-review/admin/*
        reverse_proxy @ce_music_review 127.0.0.1:18021

        # Independent physical Pulse Box · observer only.
        # This does NOT select or alter the Core20 source.
        @ce_pulse_box_snapshot {
            method GET
            path /api/pulse-box/snapshot
        }
        handle @ce_pulse_box_snapshot {
            rewrite * /snapshot
            reverse_proxy 127.0.0.1:28788
        }

        @ce_pulse_box_snapshot_path {
            path /api/pulse-box/snapshot
        }
        handle @ce_pulse_box_snapshot_path {
            respond "Method Not Allowed" 405
        }

        # Read-only native opposing-clock instruments.
        @ce_native_clock_instruments {
            method GET
            path /api/mintaka/clock /api/opposing-clocks
        }
        reverse_proxy @ce_native_clock_instruments 127.0.0.1:18020

        # Exact Chief Engineer Core20 / hardware requirements.
        @ce_core20 path /pulse /pulse/* /api/core20/calendar /api/core20/calendar/anchor /api/core20/civil-realign /api/core20/clock /api/core20/connect /api/core20/flight-recorder /api/core20/flight-recorder/clear /api/core20/runtime /api/core20/runtime/start /api/core20/runtime/stop /api/core20/runtime/resume-diagnostic /api/core20/year-angle /api/core20/year-angle/align-jpl /api/hardware/source /api/hardware/source/select /api/hardware/virtual/advance
        reverse_proxy @ce_core20 127.0.0.1:18020

        root * /srv/sites/ce.cosigo.io/public

        handle / {
            rewrite * /chief-engineer.html
            file_server
        }

        handle /chief-engineer {
            rewrite * /chief-engineer.html
            file_server
        }

        handle /music-review {
            rewrite * /music-review.html
            file_server
        }

        @ce_static path /chief-engineer.html /discipline-harness.html /discipline.html /discipline-runner.html /disturbance-recovery.html /hardware-interface.html /hardware-source.html /holdover-reacquisition.html /local-device-reader.html /multi-window-recovery.html /music-review.html /pre-actuator-seal.html /pseudo-terminal-link.html /rate-continuity.html /rate-slew.html /receive-only-transport.html /repeated-holdover.html /site-shell.css /style.css /a8-music-player-v1.js /a8-music-review-curator-v2.js

        handle @ce_static {
            file_server
        }

        handle /assets/* {
            file_server
        }

        # Anything not explicitly part of CE is denied.
        handle {
            respond "Not Found" 404
        }
    }
}


# A8 ASTRONOMICAL EVENTS · STATIC NATIVE REGISTER
events.cosigo.io {
	root * /srv/sites/events.cosigo.io/public
	file_server
}
