:80 {
	@known_hosts host trade.cosigo.io quote.cosigo.io snakepit.cosigo.io labels.cosigo.io market.cosigo.io ipfs.cosigo.io message.cosigo.io charlie.cosigo.io

	handle @known_hosts {
		redir https://{host}{uri} 308
	}

	handle {
		abort
	}
}

trade.cosigo.io {
	# COSIGO public redacted trade status JSON
	handle /status-public.json {
		root * /srv/sites/trade.cosigo.io/repo/public
		file_server
	}

	log {
		output file /var/log/caddy/trade.cosigo.io.access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 7d
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3012
	}

	handle {
		root * /srv/sites/trade.cosigo.io/public
		file_server
	}
}

