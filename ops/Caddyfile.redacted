	@a8_clock_migrated {
		path /clock.html
	}
	handle @a8_clock_migrated {
		redir https://clock.cosigo.io/ 308
	}

	# A8 MUSIC REVIEW · PRIVATE CURATOR BRIDGE

	@a8_music_submit {
		method POST
		path /api/music-review/submit
	}
	handle @a8_music_submit {
		reverse_proxy 127.0.0.1:18021
	}

	@a8_music_current {
		method GET
		path /api/music-review/current /api/music-review/weekly /api/music-review/monthly /api/music-review/yearly
	}
	handle @a8_music_current {
		reverse_proxy 127.0.0.1:18021
	}

	@a8_music_review_page {
		method GET
		path /music-review /music-review.html
	}
	handle @a8_music_review_page {
		basic_auth {
			greg <REDACTED_BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:18020
	}

	@a8_music_review_admin {
		path /api/music-review/admin/*
	}
	handle @a8_music_review_admin {
		basic_auth {
			greg <REDACTED_BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:18021
	}

	encode zstd gzip

	# CORE20 OPERATING LAB
	#
	# Public observation remains open.
	# CONNECT remains open.
	#
	# Chief Engineer operating paths require authentication.

	@a8_ce_pulse {
		path /pulse /pulse/*
	}
	handle @a8_ce_pulse {
		basic_auth {
			greg <REDACTED_BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:18020
	}

	# CHIEF ENGINEER PRIVATE READ SURFACE
	#
	# Protect the CE operations page and diagnostic recorder.
	# No recorder endpoint is live yet; this boundary is installed first.
	@a8_ce_private_read {
		method GET
		path /chief-engineer /chief-engineer.html /chief-engineer/* /api/core20/flight-recorder /api/core20/flight-recorder/*
	}
	handle @a8_ce_private_read {
		basic_auth {
			greg <REDACTED_BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:18020
	}

	# PUBLIC CORE20 DITTY CONTROLS
	#
	# Narrow downstream music controls only.
	# These do not expose runtime restart, calibration,
	# raw injection, or other Chief Engineer writes.
	@a8_public_ditty_write {
		method POST
		path /api/core20/ditty/start /api/core20/ditty/reset
	}
	handle @a8_public_ditty_write {
		reverse_proxy 127.0.0.1:18020
	}

	@a8_ce_write {
		method POST PUT PATCH DELETE
		not path /api/core20/connect
		not path /api/core20/ditty/start
		not path /api/core20/ditty/reset
	}
	handle @a8_ce_write {
		basic_auth {
			greg <REDACTED_BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:18020
	}

	# A8 LAB PRESENTATION AUTHORITY · /srv/sites
	#
	# Core20 remains machinery only.
	# Public Core20/hardware APIs cross this explicit bridge.
	# Presentation and unknown paths never fall through to Core20.

	@a8_lab_core20_api {
		path /api/core20/* /api/hardware/*
	}
	handle @a8_lab_core20_api {
		reverse_proxy 127.0.0.1:18020
	}

	handle {
		root * /srv/sites/lab.cosigo.io/public
		file_server
	}
}


# ============================================================
# A8 MOONS · CANONICAL OBSERVER HOST
# moons.cosigo.io
#
# Presentation-only hostname.
# Core20 remains at 127.0.0.1:18020.
# Exposes only the read transports required by moons.html.
# No Chief Engineer writes or blanket Core20 proxy.
# ============================================================

moons.cosigo.io {
	encode zstd gzip

	# Core20 clock snapshot · read only
	@moons_clock {
		method GET
		path /api/core20/clock
	}
	handle @moons_clock {
		reverse_proxy 127.0.0.1:18020
	}

	# Core20 authoritative edge stream · read only SSE
	@moons_edges {
		method GET
		path /api/core20/edges
	}
	handle @moons_edges {
		reverse_proxy 127.0.0.1:18020
	}

	# Jovian observer/timekeeper state · read only
	@moons_jovian {
		method GET
		path /api/hardware/jovian-timekeeper
	}
	handle @moons_jovian {
		reverse_proxy 127.0.0.1:18020
	}

	# Canonical Moons entry.
	handle / {
		root * /srv/sites/moons.cosigo.io/public
		rewrite * /moons.html
		file_server
	}

	# Preserve direct /moons.html during migration.
	handle /moons.html {
		root * /srv/sites/moons.cosigo.io/public
		file_server
	}

	# Static dependencies used by Moons.
	handle /site-shell.css {
		root * /srv/sites/moons.cosigo.io/public
		file_server
	}

	handle /assets/* {
		root * /srv/sites/moons.cosigo.io/public
		file_server
	}

	# Do NOT silently create clock/calendar/etc copies under this hostname.
	# Existing absolute-path lab navigation is returned to the old lab
	# until each destination receives its own canonical COSIGO hostname.
	handle {
		respond 404
	}
}

clock.cosigo.io {
	root * /srv/apps/a8_time_lab_v5_4_20_postseal_hw/public

	@core20_clock_get {
		method GET
		path /api/core20/clock
	}

	@core20_clock_path {
		path /api/core20/clock
	}

	@core20_edges_get {
		method GET
		path /api/core20/edges
	}

	@core20_edges_path {
		path /api/core20/edges
	}

	@core20_connect_post {
		method POST
		path /api/core20/connect
	}

	@core20_connect_path {
		path /api/core20/connect
	}

	# A8 CLOCK WEEKLY DITTY READ BRIDGE v1
	#
	# Read-only alarm preload:
	# WEEKLY first, CURRENT compatibility fallback.
	#
	# No submit/admin/publish/write path.
