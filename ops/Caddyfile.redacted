		}
		handle @audio_day_phase {
			reverse_proxy 127.0.0.1:18020
		}

		@audio_clock {
			method GET
			path /api/core20/clock
		}
		handle @audio_clock {
			reverse_proxy 127.0.0.1:18020
		}

		# Native Core20 clock-edge stream · SSE
		@audio_edges {
			method GET
			path /api/core20/edges
		}
		handle @audio_edges {
			reverse_proxy 127.0.0.1:18020
		}

		# Native ditty event stream · downstream only · SSE
		@audio_ditty_events {
			method GET
			path /api/core20/ditty/events
		}
		handle @audio_ditty_events {
			reverse_proxy 127.0.0.1:18020
		}

		# Explicit native ditty controls.
		# Core20 accepts only an empty JSON object; no timing fields.
		@audio_ditty_start {
			method POST
			path /api/core20/ditty/start
		}
		handle @audio_ditty_start {
			reverse_proxy 127.0.0.1:18020
		}

		@audio_ditty_reset {
			method POST
			path /api/core20/ditty/reset
		}
		handle @audio_ditty_reset {
			reverse_proxy 127.0.0.1:18020
		}

		# Known Audio API paths reject all other methods.
		@audio_known_api_paths {
			path /api/hardware/day-phase17 /api/core20/clock /api/core20/edges /api/core20/ditty/events /api/core20/ditty/start /api/core20/ditty/reset
		}
		handle @audio_known_api_paths {
			respond "Method Not Allowed" 405
		}

		# Everything else under /api remains below decks.
		handle /api/* {
			respond "Not Found" 404
		}

		# Canonical Audio entry.
		handle / {
			rewrite * /audio.html
			file_server
		}

		# Preserve direct source path during qualification.
		handle /audio.html {
			file_server
		}

		# Exact static dependencies only.
		handle /site-shell.css {
			file_server
		}

		handle /assets/cosigo_master_512.gif {
			file_server
		}

		handle /assets/a8_audio_antique_bg.png {
			file_server
		}

		# Unmigrated presentation destinations remain on the old lab
		# until their own canonical hostname is qualified.
		handle {
			respond 404
		}
	}
}

